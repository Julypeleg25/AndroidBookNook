<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bn_beige"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wishlist"
        android:textColor="@color/bn_brown_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wishlistRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/emptyWishlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No books in wishlist yet"
        android:textColor="@color/bn_secondary_text"
        android:textAlignment="center"
        android:visibility="gone"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Readlist"
        android:textColor="@color/bn_brown_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/readlistRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/emptyReadlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No books in readlist yet"
        android:textColor="@color/bn_secondary_text"
        android:textAlignment="center"
        android:visibility="gone"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>

</LinearLayout>
